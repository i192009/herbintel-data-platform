        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "No samples"
        },
        "overrides": []
      },
      "description": "Cloud credentials were not configured during local acceptance. Zero means no recorded cloud work, rather than a verified cloud deployment."
    },
