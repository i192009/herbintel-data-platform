FROM golang:1.26.10-bookworm AS build
ENV CGO_ENABLED=0
RUN go install github.com/minio/minio@v0.0.0-20250422221226-0d7408fc9969
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/* && useradd --uid 10001 --create-home minio && install -d -o 10001 -g 10001 /data
COPY --from=build /go/bin/minio /usr/local/bin/minio
USER 10001:10001
ENTRYPOINT ["minio"]
